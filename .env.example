# ─────────────────────────────────────────────
# SiteVoice AI — Environment Variables
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# ── General ───────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ── Database (PostgreSQL) ─────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sitevoice_db
DB_USER=postgres
DB_PASSWORD=

# ── JWT Auth ──────────────────────────────────
JWT_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── AI / LLM ─────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── File Uploads ──────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=26214400

# ── Email / SMTP ──────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@sitevoice.ai

# ── Frontend ──────────────────────────────────
FRONTEND_URL=http://localhost:8081
